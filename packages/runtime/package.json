{
  "name": "@goodagent/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./external-skills": {
      "types": "./dist/external-skills.d.ts",
      "default": "./dist/external-skills.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "deploy:spike": "tsx scripts/deploy-spike.mts",
    "deploy:balaio-local": "tsx scripts/deploy-balaio-local.mts",
    "deploy:gamearena-cli": "tsx scripts/deploy-gamearena-cli.mts",
    "test:partner-gamearena": "tsx scripts/test-partner-gamearena-api.mts",
    "test:partner-actionorder": "tsx scripts/test-partner-actionorder-api.mts",
    "test:proof-of-alpha-hunt": "tsx scripts/test-proof-of-alpha-hunt.mts",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodagent/agent-brain": "workspace:*",
    "@goodagent/agent-id": "workspace:*",
    "@goodagent/agent-runtime": "workspace:*",
    "@goodagent/db": "workspace:*",
    "@goodagent/shared": "workspace:*",
    "@goodagent/skill-sdk": "workspace:*",
    "dotenv": "^16.5.0",
    "viem": "^2.31.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
