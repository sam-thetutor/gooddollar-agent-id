{
  "name": "@goodagent/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "goodagent-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stub/hello-world": {
      "types": "./dist/stub/hello-world.d.ts",
      "default": "./dist/stub/hello-world.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@goodagent/skill-sdk": "workspace:*",
    "viem": "^2.31.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
