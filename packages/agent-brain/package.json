    "test": "node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts"
  },
  "dependencies": {
    "@goodagent/chain": "workspace:*",
    "@goodagent/shared": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
